<scheme>
    <title>SSL/TLS Certificate Monitor</title>
    <description>Monitors SSL/TLS certificate expirations, trust chains, and cipher suites.</description>
    <use_external_validation>true</use_external_validation>
    <streaming_mode>xml</streaming_mode>
    <use_single_instance>true</use_single_instance>
    <endpoint>
        <args>
            <arg name="targets_csv">
                <title>Targets CSV File</title>
                <description>Optional: Filename in lookups/ (e.g. ssl_targets.csv) or full path to a
                    CSV target list.</description>
                <required_on_create>false</required_on_create>
            </arg>
            <arg name="target_host">
                <title>Target Host</title>
                <description>Hostname or IP address (used if not loading from CSV).</description>
                <required_on_create>false</required_on_create>
            </arg>
            <arg name="port">
                <title>Port</title>
                <description>Port number (default 443).</description>
                <required_on_create>false</required_on_create>
            </arg>
            <arg name="sni">
                <title>SNI</title>
                <description>Server Name Indication hostname.</description>
                <required_on_create>false</required_on_create>
            </arg>
            <arg name="verify_cert">
                <title>Verify Certificate</title>
                <description>Enforce valid certificate chain (true/false).</description>
                <required_on_create>false</required_on_create>
            </arg>
            <arg name="timeout">
                <title>Timeout</title>
                <description>Connection timeout in seconds (1-30).</description>
                <required_on_create>false</required_on_create>
            </arg>
        </args>
    </endpoint>
</scheme>