{
    "pages": {
        "configuration": {
            "title": "Configuration",
            "description": "Set up your SSL/TLS Certificate Monitoring Add-On",
            "tabs": [
                {
                    "name": "proxy",
                    "title": "Proxy Settings",
                    "entity": [
                        {
                            "field": "proxy_enabled",
                            "label": "Enable Proxy",
                            "type": "checkbox",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "field": "proxy_url",
                            "label": "Proxy Host / IP",
                            "type": "text",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^([a-zA-Z0-9.-]+|([0-9]{1,3}\\.){3}[0-9]{1,3})$",
                                    "errorMsg": "Please provide a valid hostname or IP address without protocol schemes (http/https)."
                                }
                            ],
                            "help": "Hostname or IP address of the proxy server."
                        },
                        {
                            "field": "proxy_port",
                            "label": "Proxy Port",
                            "type": "text",
                            "defaultValue": "8080",
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Proxy port must be a valid port number between 1 and 65535.",
                                    "range": [
                                        1,
                                        65535
                                    ],
                                    "isInteger": true
                                }
                            ],
                            "required": false,
                            "help": "Default proxy port is 8080."
                        },
                        {
                            "field": "proxy_username",
                            "label": "Proxy Username",
                            "type": "text",
                            "required": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of username should be between 3 and 64 characters.",
                                    "minLength": 3,
                                    "maxLength": 64
                                }
                            ],
                            "help": "Username for proxy authentication (optional)."
                        },
                        {
                            "field": "proxy_password",
                            "label": "Proxy Password",
                            "type": "text",
                            "encrypted": true,
                            "required": false,
                            "help": "Password for proxy authentication (optional)."
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
            ]
        },
        "inputs": {
            "title": "SSL Certificate Probes",
            "description": "Manage active TLS/SSL endpoint monitoring targets.",
            "subDescription": {
                "text": "Ingesting data from to Splunk Enterprise?\nRead my [[wikiPost]] to learn more",
                "links": [
                    {
                        "slug": "wikiPost",
                        "link": "https://github.com/Tes3awy/splunk-ssl-cert-monitor/wiki",
                        "linkText": "Wiki"
                    }
                ]
            },
            "services": [
                {
                    "template": "input_with_helper",
                    "name": "cert_checker",
                    "title": "Certificate Endpoint",
                    "entity": [
                        {
                            "type": "singleSelect",
                            "field": "index",
                            "label": "Index",
                            "defaultValue": "ssl_cert",
                            "required": true,
                            "options": {
                                "endpointUrl": "data/indexes",
                                "createSearchChoice": true,
                                "denyList": "^_.*$"
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 80,
                                    "errorMsg": "Length of index name should be between 1 and 80."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "field": "name",
                            "label": "Name",
                            "required": true,
                            "help": "Unique stanza name (alphanumeric characters, hyphens, and underscores only).",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^[a-zA-Z0-9_.-]+$",
                                    "errorMsg": "Name can only contain alphanumeric characters, underscores, dots, and hyphens."
                                },
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "errorMsg": "Name length must be between 1 and 128 characters."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "field": "target_host",
                            "label": "Target Host / IP",
                            "required": true,
                            "help": "Fully qualified domain name or IP (e.g., example.com, not https://example.com).",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^([a-zA-Z0-9.-]+|([0-9]{1,3}\\.){3}[0-9]{1,3})$",
                                    "errorMsg": "Please provide a valid hostname or IP address without protocol schemes."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "field": "port",
                            "label": "Port",
                            "defaultValue": "443",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Port must be a valid number between 1 and 65535.",
                                    "range": [
                                        1,
                                        65535
                                    ],
                                    "isInteger": true
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "field": "sni",
                            "label": "SNI",
                            "help": "Server Name Indication hostname (optional, defaults to Target Host if omitted).",
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "SNI length must be between 1 and 255 characters.",
                                    "minLength": 1,
                                    "maxLength": 255
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "field": "timeout",
                            "label": "Connection Timeout",
                            "help": "Connection timeout in seconds.",
                            "defaultValue": "10",
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Timeout must be between 5 and 300 seconds.",
                                    "range": [
                                        5,
                                        300
                                    ],
                                    "isInteger": true
                                }
                            ]
                        },
                        {
                            "type": "checkbox",
                            "field": "verify_cert",
                            "label": "Strict Root Verification",
                            "help": "Enforce strict root CA trust path validation against system trust store.",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "type": "checkbox",
                            "field": "audit_legacy_protocols",
                            "label": "Audit Legacy Protocols",
                            "help": "Actively probe the endpoint for deprecated TLS 1.0 and TLS 1.1 support.",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "type": "interval",
                            "field": "interval",
                            "label": "Scan Interval",
                            "help": "Polling interval in seconds (default is 86400 / 24 hours).",
                            "defaultValue": "86400",
                            "required": true
                        }
                    ]
                }
            ],
            "table": {
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Target Host",
                        "field": "target_host"
                    },
                    {
                        "label": "Port",
                        "field": "port"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Inactive",
                            "false": "Active"
                        }
                    }
                ],
                "moreInfo": [
                    {
                        "label": "SNI",
                        "field": "sni"
                    },
                    {
                        "label": "Timeout (s)",
                        "field": "timeout"
                    },
                    {
                        "label": "Strict Verification",
                        "field": "verify_cert"
                    },
                    {
                        "label": "Audit Legacy Protocols",
                        "field": "audit_legacy_protocols"
                    }
                ],
                "actions": [
                    "search",
                    "edit",
                    "clone",
                    "delete"
                ]
            }
        }
    },
    "meta": {
        "displayName": "Splunk Add-on for SSL/TLS Certificate Monitoring",
        "name": "TA-cert-monitor",
        "restRoot": "ta_cert_monitor",
        "version": "2.1.6",
        "schemaVersion": "0.0.10",
        "hideUCCVersion": false,
        "checkForUpdates": true,
        "defaultView": "inputs",
        "navColor": "#0072C6",
        "supportedThemes": [
            "light",
            "dark"
        ],
        "supportedPythonVersion": [
            "3.9",
            "3.13"
        ],
        "isVisible": true,
        "showFooter": true
    }
}