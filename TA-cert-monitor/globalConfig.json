{
    "pages": {
        "configuration": {
            "title": "Configuration",
            "description": "Set up your add-on",
            "tabs": [
                {
                    "name": "proxy",
                    "title": "Proxy Settings",
                    "entity": [
                        {
                            "field": "proxy_enabled",
                            "label": "Enable Proxy",
                            "type": "checkbox",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "field": "proxy_url",
                            "label": "Proxy Host / IP",
                            "type": "text",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^([a-zA-Z0-9.-]+|([0-9]{1,3}\\.){3}[0-9]{1,3})$",
                                    "errorMsg": "Please provide a valid hostname or IP address."
                                }
                            ],
                            "help": {
                                "text": "Proxy Host / IP"
                            }
                        },
                        {
                            "field": "proxy_port",
                            "label": "Proxy Port",
                            "type": "text",
                            "defaultValue": "8080",
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Input must a number.",
                                    "range": [
                                        0,
                                        65535
                                    ]
                                }
                            ],
                            "required": false,
                            "help": {
                                "text": "Default value 8080"
                            }
                        },
                        {
                            "field": "proxy_username",
                            "label": "Proxy Username",
                            "type": "text",
                            "required": false,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of username should be between 3 and 30",
                                    "minLength": 1,
                                    "maxLength": 8192
                                }
                            ],
                            "help": {
                                "text": "Proxy Username"
                            }
                        },
                        {
                            "field": "proxy_password",
                            "label": "Proxy Password",
                            "type": "text",
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of Password should be between 1 and 8192",
                                    "minLength": 1,
                                    "maxLength": 8192
                                }
                            ],
                            "encrypted": true,
                            "required": false,
                            "help": {
                                "text": "Proxy Password"
                            }
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
            ]
        },
        "inputs": {
            "title": "Certificate Probes",
            "description": "Manage active TLS/SSL endpoint monitoring targets.",
            "subDescription": {
                "text": "Ingesting data from to Splunk Enterprise?\nRead my [[wikiPost]] to learn more",
                "links": [
                    {
                        "slug": "wikiPost",
                        "link": "https://github.com/Tes3awy/splunk-ssl-cert-monitor/wiki",
                        "linkText": "Wiki"
                    }
                ]
            },
            "services": [
                {
                    "name": "cert_checker",
                    "title": "Certificate Endpoint",
                    "entity": [
                        {
                            "field": "index",
                            "label": "Index",
                            "type": "index",
                            "defaultValue": "ssl_cert",
                            "required": true
                        },
                        {
                            "field": "name",
                            "label": "Name",
                            "type": "text",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of Name should be between 1 and 8192",
                                    "minLength": 1,
                                    "maxLength": 8192
                                }
                            ]
                        },
                        {
                            "field": "target_host",
                            "label": "Target Host / IP",
                            "type": "text",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input should be between 1 and 8192",
                                    "minLength": 1,
                                    "maxLength": 8192
                                }
                            ]
                        },
                        {
                            "field": "port",
                            "label": "Port",
                            "type": "text",
                            "defaultValue": "443",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Input must a number.",
                                    "range": [
                                        0,
                                        65535
                                    ]
                                }
                            ]
                        },
                        {
                            "field": "sni",
                            "label": "SNI",
                            "help": "Server Name Indication",
                            "type": "text",
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of SNI should be between 1 and 8192",
                                    "minLength": 1,
                                    "maxLength": 8192
                                }
                            ]
                        },
                        {
                            "field": "timeout",
                            "label": "Connection Timeout (in seconds)",
                            "type": "text",
                            "defaultValue": "10",
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Input must a number.",
                                    "range": [
                                        10,
                                        1200
                                    ]
                                }
                            ]
                        },
                        {
                            "field": "verify_cert",
                            "label": "Strict Root Verification",
                            "type": "checkbox",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "field": "audit_legacy_protocols",
                            "label": "Audit Legacy Protocols",
                            "help": "Actively probe the endpoint for deprecated TLS 1.0 and TLS 1.1 support.",
                            "type": "checkbox",
                            "defaultValue": false,
                            "required": false
                        },
                        {
                            "field": "interval",
                            "label": "Scan Interval (seconds)",
                            "type": "text",
                            "defaultValue": "86400",
                            "required": true,
                            "validators": [
                                {
                                    "type": "number",
                                    "errorMsg": "Input must a number.",
                                    "range": [
                                        30,
                                        86400
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ],
            "table": {
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Target Host",
                        "field": "target_host"
                    },
                    {
                        "label": "Port",
                        "field": "port"
                    },
                    {
                        "label": "Interval",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "SNI",
                        "field": "sni"
                    },
                    {
                        "label": "Timeout (s)",
                        "field": "timeout"
                    },
                    {
                        "label": "Strict Verification",
                        "field": "verify_cert"
                    },
                    {
                        "label": "Audit Legacy Protocols",
                        "field": "audit_legacy_protocols"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Disabled",
                            "false": "Enabled"
                        }
                    }
                ],
                "actions": [
                    "edit",
                    "clone",
                    "delete",
                    "search"
                ]
            }
        }
    },
    "meta": {
        "displayName": "Splunk Add-on for SSL/TLS Certificate Monitoring",
        "name": "TA-cert-monitor",
        "restRoot": "ta_cert_monitor",
        "version": "2.1.0",
        "schemaVersion": "0.0.10",
        "supportedPythonVersion": [
            "3.13"
        ],
        "supportedThemes": [
            "light",
            "dark"
        ],
        "defaultView": "configuration",
        "checkForUpdates": true,
        "hideUCCVersion": false,
        "navColor": "#65A637",
        "isVisible": false,
        "showFooter": true
    }
}
