<form version="1.1" theme="dark">
  <label>SSL/TLS Certificate Executive Overview</label>
  <description>Real-time lifecycle monitoring, trust chain audit, and revocation analysis.</description>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_tok" searchWhenChanged="true">
      <label>Scan Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="status_filter" searchWhenChanged="true">
      <label>Status Filter</label>
      <choice value="*">All Statuses</choice>
      <choice value="VALID">VALID</choice>
      <choice value="EXPIRING_WARNING">EXPIRING_WARNING (&lt;= 30d)</choice>
      <choice value="EXPIRING_CRITICAL">EXPIRING_CRITICAL (&lt;= 15d)</choice>
      <choice value="EXPIRED">EXPIRED</choice>
      <choice value="REVOKED">REVOKED</choice>
      <choice value="CONNECTION_ERROR">CONNECTION_ERROR</choice>
      <default>*</default>
    </input>
    <input type="text" token="host_filter" searchWhenChanged="true">
      <label>Search Domain / Host</label>
      <default>*</default>
    </input>
  </fieldset>

  <!-- Row 1: KPI Summary Metrics -->
  <row>
    <panel>
      <single>
        <title>Monitored Endpoints</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype` | stats dc(dest) as count</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["#1e88e5","#1e88e5"]</option>
        <option name="underLabel">Unique Hosts Scanned</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Active Certificates</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype` status!="CONNECTION_ERROR"
            | stats latest(status) as status by dest, dest_port
            | search status="VALID"
            | stats count</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["#43a047","#43a047"]</option>
        <option name="underLabel">Valid &amp; Healthy</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Expiring &lt;= 30 Days</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype` status!="CONNECTION_ERROR"
            | stats latest(days_remaining) as days by dest, dest_port
            | search days &gt; 0 AND days &lt;= 30
            | stats count</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["#000000","#fb8c00"]</option>
        <option name="rangeValues">[0]</option>
        <option name="underLabel">Urgent Renewal Needed</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Expired / Revoked</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype`
            | stats latest(status) as status by dest, dest_port
            | search status="EXPIRED" OR status="REVOKED"
            | stats count</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="rangeColors">["#000000","#e53935"]</option>
        <option name="rangeValues">[0]</option>
        <option name="underLabel">Critical Outages / Revocations</option>
      </single>
    </panel>
  </row>

  <!-- Row 2: Status Breakdown & Cipher Distribution -->
  <row>
    <panel>
      <chart>
        <title>Expiration Timeline Distribution</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype` status!="CONNECTION_ERROR"
            | stats latest(days_remaining) as days by dest, dest_port
            | eval Expiry_Bucket=case(
            days &lt;= 0, "01. Expired",
            days &lt;= 14, "02. Critical (&lt;= 14d)",
            days &lt;= 30, "03. High (&lt;= 30d)",
            days &lt;= 60, "04. Medium (&lt;= 60d)",
            days &lt;= 90, "05. Approaching (&lt;= 90d)",
            1=1, "06. Healthy (&gt; 90d)"
            )
            | chart count by Expiry_Bucket</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.chart.sliceCollapsingThreshold">0</option>
        <option name="charting.fieldColors">{"01. Expired": #e53935, "02. Critical (&lt;= 14d)":
          #fb8c00, "03. High (&lt;= 30d)": #fdd835, "06. Healthy (&gt; 90d)": #43a047}</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>TLS Versions &amp; Cipher Suites</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype` ssl_version=*
            | chart count over ssl_version by ssl_cipher</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.chart.stackMode">stacked</option>
      </chart>
    </panel>
  </row>

  <!-- Row 3: Actionable Certificate Details Table -->
  <row>
    <panel>
      <table>
        <title>Target Certificate Inventory &amp; Expiry Health</title>
        <search>
          <query>`ssl_cert_index` `ssl_cert_sourcetype`
            | search dest=$host_filter$ OR sni=$host_filter$
            | stats latest(status) as status,
            latest(days_remaining) as days_remaining,
            latest(valid_to) as valid_to,
            latest(issuer_cn) as issuer_cn,
            latest(is_self_signed) as is_self_signed,
            latest(revocation_status) as revocation_status,
            latest(ssl_version) as ssl_version,
            latest(ssl_cipher) as ssl_cipher
            by dest, dest_port, sni
            | search status=$status_filter$
            | sort days_remaining asc
            | eval days_remaining=round(days_remaining, 1)
            | rename dest as "Target Host", dest_port as "Port", sni as "SNI", status as "Status",
            days_remaining as "Days Left", valid_to as "Expiry Date", issuer_cn as "CA Issuer",
            is_self_signed as "Self Signed", revocation_status as "OCSP Status",
            ssl_version as "TLS Version", ssl_cipher as "Cipher Suite"</query>
          <earliest>$time_tok.earliest$</earliest>
          <latest>$time_tok.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="dataOverlayMode">none</option>
        <format type="color" field="Days Left">
          <colorPalette type="minMidMax" maxColor="#43a047" midColor="#fb8c00" minColor="#e53935"
            midPoint="30" minValue="0"></colorPalette>
        </format>
        <format type="color" field="Status">
          <colorPalette type="map">{"VALID": #43a047, "EXPIRING_WARNING": #fb8c00,
            "EXPIRING_CRITICAL": #e53935, "EXPIRED": #b71c1c, "REVOKED": #b71c1c,
            "CONNECTION_ERROR": #8e24aa, "UNKNOWN": #757575}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
</form>